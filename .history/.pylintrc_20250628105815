[MASTER]
# 文字エンコーディングを指定
output-format=text
reports=no
score=no
ignore=venv,__pycache__,.git

[MESSAGES CONTROL]
# 日本語文字列に関する警告を無効化
disable=C0114,C0115,C0116,W0511,W0621,W0703,W0612,W0613,C0301

[REPORTS]
# レポートの出力形式
output-format=text
reports=no

[FORMAT]
# 最大行長を設定
max-line-length=120

[BASIC]
# 良い変数名のパターン
good-names=i,j,k,ex,Run,_,id,db

[SIMILARITIES]
# 類似コードの検出設定
min-similarity-lines=4
ignore-comments=yes
ignore-docstrings=yes
ignore-imports=yes 