{
  "project_name": "qc_ariken_tokyo",
  "description": "有研東京検査所 精度管理システム",
  "version": "1.0.0",
  "model_config": {
    "provider": "ollama",
    "model": "llama3.2:7b",
    "temperature": 0.3,
    "max_tokens": 2048,
    "context_window": 8192
  },
  "code_assistance": {
    "auto_complete": true,
    "code_generation": true,
    "refactoring": true,
    "debugging": true,
    "testing": true,
    "documentation": true
  },
  "file_patterns": {
    "include": [
      "*.py",
      "*.pyx",
      "*.pyi",
      "*.sql",
      "*.md",
      "*.txt",
      "*.json",
      "*.yaml",
      "*.yml"
    ],
    "exclude": [
      "*.pyc",
      "__pycache__",
      ".git",
      ".venv",
      "node_modules",
      "*.log",
      "*.db",
      "*.sqlite",
      "*.sqlite3"
    ]
  },
  "context_files": [
    "requirements.txt",
    "qc_ariken_tokyo.py",
    "src/config.py",
    "docs/specification.md",
    "docs/structure_diagram.md"
  ],
  "custom_prompts": {
    "streamlit_app": "このコードはStreamlitアプリケーションの一部です。Streamlitのベストプラクティスに従い、適切なコンポーネントとレイアウトを使用してください。",
    "database_operation": "このコードはSQLiteデータベース操作を含みます。適切なエラーハンドリング、トランザクション管理、SQLインジェクション対策を実装してください。",
    "qc_data_processing": "このコードはQC（品質管理）データの処理を行います。データの整合性、精度、トレーサビリティを確保してください。",
    "logging": "適切なログ出力を追加し、デバッグと監査に役立つ情報を記録してください。",
    "error_handling": "包括的なエラーハンドリングを実装し、ユーザーフレンドリーなエラーメッセージを提供してください。"
  },
  "code_style": {
    "python": {
      "formatter": "black",
      "line_length": 79,
      "docstring_style": "google",
      "import_sorting": "isort"
    },
    "sql": {
      "formatter": "sqlformat",
      "style": "uppercase"
    }
  },
  "testing": {
    "framework": "pytest",
    "coverage_threshold": 80,
    "test_pattern": "test_*.py",
    "mock_libraries": ["sqlite3", "pandas", "streamlit"]
  },
  "documentation": {
    "format": "markdown",
    "include_examples": true,
    "include_diagrams": true,
    "language": "ja"
  }
} 